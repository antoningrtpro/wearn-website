NEXT_PUBLIC_APP_URL_RUNNER_SIGNUP=https://app.wearn.fr/inscription-coureur

# Resend API key used to send contact form notifications (get one at resend.com)
RESEND_API_KEY=

# Comma-separated list of recipients for contact form notifications.
# Defaults to antonin@wearn.fr when unset. Admins can add more emails here
# without touching the code.
CONTACT_NOTIFY_EMAILS=antonin@wearn.fr

# Sender address used for contact notification emails. Must be on a domain
# verified in Resend, otherwise keep the resend.dev fallback for testing.
CONTACT_FROM_EMAIL=Wearn <onboarding@resend.dev>
